# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application
APP_URL=http://localhost:5173
PORT=3001
VITE_CURRENCY=USD

# Billing: "simulate" (no Stripe needed) or "stripe"
BILLING_MODE=simulate
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Notifications: leave empty to log emails to the console (mock adapter)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Jobs: protects /api/cron/reminders (Vercel sends it automatically)
CRON_SECRET=change-me
